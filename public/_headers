# Static asset caching for the Workers assets binding (copied to dist/client).
# Hashed build output can be cached immutably; unhashed images/fonts get a long
# TTL with ETag revalidation (they can be replaced under the same name).

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000

/pics/*
  Cache-Control: public, max-age=31536000

/portofolio/*
  Cache-Control: public, max-age=31536000

/icons/*
  Cache-Control: public, max-age=31536000

/ls400.webp
  Cache-Control: public, max-age=31536000

/crown.webp
  Cache-Control: public, max-age=31536000
