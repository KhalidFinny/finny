{
  // NOTE: restored from the last committed tsconfig (HEAD), with two
  // additions for the Cloudflare/TanStack stack: worker-configuration.d.ts
  // is included so `cloudflare:workers` module declarations typecheck.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
